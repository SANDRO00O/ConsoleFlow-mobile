{
  "manifest_version": 2,
  "name": "ConsoleFlow Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "bridge@consoleflow.karrarnazim.space" }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
