<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- ── Top bar ──────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bottom_btn_ripple"
            android:src="@drawable/arrow_left"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fine-tune the browser and developer tools"
                android:textColor="#555555"
                android:textSize="@dimen/menu_item_text_size" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A1A" />

    <!-- ── Scrollable content ─────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── BROWSER ────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="6dp"
                android:text="BROWSER"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">

                <!-- Search Engine -->
                <LinearLayout
                    android:id="@+id/settingSearchEngine"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_find"
                        android:tint="#888888" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Default Search Engine"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size" />

                    <TextView
                        android:id="@+id/settingSearchEngineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google"
                        android:textColor="#666666"
                        android:textSize="@dimen/menu_chip_text_size" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/arrow_right"
                        android:tint="#333333" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="#1A1A1A" />

                <!-- Desktop Mode -->
                <LinearLayout
                    android:id="@+id/settingDesktopMode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_desktop"
                        android:tint="#888888" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="Desktop Mode"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDesktopMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/SwitchTheme" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="#1A1A1A" />

                <!-- Search Suggestions -->
                <LinearLayout
                    android:id="@+id/settingSearchSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_find"
                        android:tint="#888888" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search Suggestions"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/menu_item_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show suggestions as you type"
                            android:textColor="#555555"
                            android:textSize="@dimen/menu_item_text_size" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSuggestions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/SwitchTheme" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── DEVELOPER ──────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="6dp"
                android:text="DEVELOPER"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">

                <!-- Custom JS -->
                <LinearLayout
                    android:id="@+id/settingCustomJs"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_code"
                        android:tint="#888888" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom JavaScript"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/menu_item_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Injected on every page load"
                            android:textColor="#555555"
                            android:textSize="@dimen/menu_item_text_size" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/arrow_right"
                        android:tint="#333333" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── DATA ───────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="6dp"
                android:text="DATA"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">

                <!-- Clear Data -->
                <LinearLayout
                    android:id="@+id/settingClearData"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_clear"
                        android:tint="#CC4444" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear Browsing Data"
                            android:textColor="#CC4444"
                            android:textSize="@dimen/menu_item_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cache, cookies and history"
                            android:textColor="#663333"
                            android:textSize="@dimen/menu_item_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── DEVELOPER ───────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="6dp"
                android:text="DEVELOPER"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">

                <!-- View Logs -->
                <LinearLayout
                    android:id="@+id/settingViewLogs"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
                        android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_code"
                        android:tint="#888888" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View Logs"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/menu_item_text_size" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diagnostics, errors and app activity"
                            android:textColor="#888888"
                            android:textSize="@dimen/menu_item_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── ABOUT ───────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="6dp"
                android:text="ABOUT"
                android:textColor="#555555"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settingAbout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/menu_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
                        android:src="@drawable/ic_settings"
                        android:tint="#888888" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="About ConsoleFlow"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/menu_item_text_size" />

                    <!-- Update available badge -->
                    <TextView
                        android:id="@+id/updateDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/update_dot"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="UPDATE"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/arrow_right"
                        android:tint="#333333" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
