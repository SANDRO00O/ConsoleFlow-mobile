<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Top Bar -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_12"
        android:background="@color/dark_bg_secondary">
        
        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:padding="@dimen/spacing_12"
            android:background="@drawable/bottom_btn_ripple"
            android:src="@drawable/arrow_left"
            android:tint="@color/dark_text_primary"
            android:scaleType="fitCenter" />
        
        <!-- Title Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/dark_text_primary"
                android:textSize="@dimen/text_size_headline_medium"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fine-tune the browser and developer tools"
                android:textColor="@color/dark_text_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:layout_marginTop="@dimen/spacing_4" />
        </LinearLayout>
    </LinearLayout>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/card_border" />
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Scrollable Content -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/settings_padding"
        android:paddingVertical="@dimen/spacing_16">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- ════ BROWSER Section ════ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BROWSER" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">
                
                <!-- Search Engine -->
                <LinearLayout
                    android:id="@+id/settingSearchEngine"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_find"
                        android:tint="@color/primary_light"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default Search Engine"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/settingSearchEngineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google"
                        android:textColor="@color/dark_text_secondary"
                        android:textSize="@dimen/text_size_body_medium"
                        android:layout_marginEnd="@dimen/spacing_8" />
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                
                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginHorizontal="@dimen/settings_row_padding"
                    android:background="@color/card_border" />
                
                <!-- Desktop Mode -->
                <LinearLayout
                    android:id="@+id/settingDesktopMode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_desktop"
                        android:tint="@color/secondary_light"
                        android:scaleType="fitCenter" />
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:text="Desktop Mode"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />
                    
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDesktopMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/SwitchTheme" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- ════ DEVELOPER Section ════ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVELOPER"
                android:layout_marginTop="@dimen/settings_section_margin_top" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">
                
                <!-- Custom JS -->
                <LinearLayout
                    android:id="@+id/settingCustomJs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_code"
                        android:tint="@color/tertiary_light"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom JavaScript"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Injected on every page load"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- ════ DATA Section ════ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DATA"
                android:layout_marginTop="@dimen/settings_section_margin_top" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">
                
                <!-- Clear Data -->
                <LinearLayout
                    android:id="@+id/settingClearData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_clear"
                        android:tint="@color/error"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear Browsing Data"
                            android:textColor="@color/error"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cache, cookies and history"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            
            <!-- ════ ABOUT Section ════ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                android:layout_marginTop="@dimen/settings_section_margin_top" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">
                
                <LinearLayout
                    android:id="@+id/settingAbout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/settings_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/primary_light"
                        android:scaleType="fitCenter" />
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:text="About ConsoleFlow"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold" />
                    
                    <!-- Update Badge -->
                    <TextView
                        android:id="@+id/updateDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/tertiary_light"
                        android:textSize="@dimen/text_size_body_large"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:visibility="gone" />
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- Bottom Padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_32" />
        </LinearLayout>
    </ScrollView>
    
</LinearLayout>
