<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_bg_secondary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_16">
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Drag Handle -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_24"
        android:gravity="center"
        android:layout_marginBottom="@dimen/spacing_12">
        <View
            android:layout_width="@dimen/bottom_sheet_handle_width"
            android:layout_height="@dimen/bottom_sheet_handle_height"
            android:layout_gravity="center"
            android:background="@color/card_border"
            android:alpha="0.4" />
    </FrameLayout>
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Menu Items Grid (4 columns) -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:columnOrderPreserved="false">
        
        <!-- Night Mode -->
        <LinearLayout
            android:id="@+id/menuNightMode"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_moon"
                android:tint="@color/tertiary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:id="@+id/menuNightModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Night Mode"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Bookmarks -->
        <LinearLayout
            android:id="@+id/menuBookmarks"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_bookmarks"
                android:tint="@color/secondary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bookmarks"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- History -->
        <LinearLayout
            android:id="@+id/menuHistory"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_history"
                android:tint="@color/primary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Console Toggle -->
        <LinearLayout
            android:id="@+id/menuConsoleToggle"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_code"
                android:tint="@color/error"
                android:scaleType="fitCenter" />
            
            <TextView
                android:id="@+id/menuConsoleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Console Off"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Find in Page -->
        <LinearLayout
            android:id="@+id/menuFindInPage"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_find"
                android:tint="@color/secondary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find in Page"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Desktop Mode -->
        <LinearLayout
            android:id="@+id/menuDesktopMode"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_desktop"
                android:tint="@color/primary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:id="@+id/menuDesktopModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desktop"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Settings -->
        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_settings"
                android:tint="@color/secondary_light"
                android:scaleType="fitCenter" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
        <!-- Clear Data -->
        <LinearLayout
            android:id="@+id/menuClearData"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_item_height"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/spacing_6"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/menu_item_ripple"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="@dimen/menu_item_icon_size"
                android:layout_height="@dimen/menu_item_icon_size"
                android:src="@drawable/ic_download"
                android:tint="@color/error"
                android:scaleType="fitCenter" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Data"
                android:textColor="@color/menu_item_text"
                android:textSize="@dimen/menu_item_text_size"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/spacing_8"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        
    </GridLayout>
    
</LinearLayout>
