<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Top Bar -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_12"
        android:background="@color/dark_bg_secondary">
        
        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:padding="@dimen/spacing_12"
            android:background="@drawable/bottom_btn_ripple"
            android:src="@drawable/arrow_left"
            android:tint="@color/dark_text_primary"
            android:scaleType="fitCenter" />
        
        <!-- Title Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_12"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About"
                android:textColor="@color/dark_text_primary"
                android:textSize="@dimen/text_size_headline_medium"
                android:textStyle="bold" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version info and release notes"
                android:textColor="@color/dark_text_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:layout_marginTop="@dimen/spacing_4" />
        </LinearLayout>
    </LinearLayout>
    
    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/card_border" />
    
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Scrollable Content -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="false">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/settings_padding"
            android:paddingVertical="@dimen/spacing_16">
            
            <!-- ════ App Identity Section ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="@dimen/spacing_32">
                
                <!-- Banner SVG -->
                <WebView
                    android:id="@+id/bannerWebView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/about_banner_height"
                    android:background="@color/dark_bg_secondary"
                    android:alpha="0.9" />
                
                <!-- Version -->
                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="v2.2.7"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="@dimen/text_size_body_medium" />
            </LinearLayout>
            
            <!-- ════ Update Status Card ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_16">
                
                <!-- Loading State -->
                <LinearLayout
                    android:id="@+id/updateLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <ProgressBar
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary"
                        style="?android:attr/progressBarStyle" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:text="Checking for updates…"
                        android:textColor="@color/dark_text_secondary"
                        android:textSize="@dimen/text_size_body_medium" />
                </LinearLayout>
                
                <!-- Up to Date State -->
                <LinearLayout
                    android:id="@+id/updateUpToDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <View
                        android:layout_width="@dimen/status_dot_size"
                        android:layout_height="@dimen/status_dot_size"
                        android:background="@drawable/update_dot"
                        android:backgroundTint="@color/success" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:text="You're on the latest version"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="@dimen/text_size_body_medium" />
                </LinearLayout>
                
                <!-- Update Available State -->
                <LinearLayout
                    android:id="@+id/updateAvailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <View
                            android:layout_width="@dimen/status_dot_size"
                            android:layout_height="@dimen/status_dot_size"
                            android:background="@drawable/update_dot"
                            android:backgroundTint="@color/tertiary_light" />
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_12"
                            android:text="Update Available"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:id="@+id/tvLatestVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="v2.3.0"
                            android:textColor="@color/tertiary_light"
                            android:textSize="@dimen/text_size_body_medium"
                            android:textStyle="bold" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/btnDownload"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:background="@drawable/menu_item_ripple"
                        android:gravity="center"
                        android:text="View Release on GitHub  →"
                        android:textColor="@color/tertiary_light"
                        android:textSize="@dimen/text_size_body_medium"
                        android:textStyle="bold" />
                </LinearLayout>
                
                <!-- Error State -->
                <LinearLayout
                    android:id="@+id/updateError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Could not check for updates"
                        android:textColor="@color/dark_text_secondary"
                        android:textSize="@dimen/text_size_body_medium" />
                </LinearLayout>
                
                <!-- Divider + Check Again -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginVertical="@dimen/spacing_12"
                    android:background="@color/card_border" />
                
                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple"
                    android:text="Check again"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>
            
            <!-- ════ Changelog Section ════ -->
            <LinearLayout
                android:id="@+id/changelogSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_24"
                android:visibility="gone">
                
                <TextView
                    style="@style/SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WHAT'S NEW" />
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_menu_item"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_16"
                    android:paddingVertical="@dimen/spacing_16">
                    
                    <TextView
                        android:id="@+id/tvChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dark_text_secondary"
                        android:textSize="@dimen/text_size_body_medium"
                        android:lineSpacingExtra="@dimen/spacing_6" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- ════ Links Section ════ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LINKS"
                android:layout_marginTop="@dimen/spacing_24" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_item"
                android:orientation="vertical">
                
                <!-- App Website -->
                <LinearLayout
                    android:id="@+id/linkWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_desktop"
                        android:tint="@color/primary_light"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Website"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="consoleflow.karrarnazim.space"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                
                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginHorizontal="@dimen/settings_row_padding"
                    android:background="@color/card_border" />
                
                <!-- Developer -->
                <LinearLayout
                    android:id="@+id/linkDeveloper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/secondary_light"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Developer"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karrar Nazim"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                
                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginHorizontal="@dimen/settings_row_padding"
                    android:background="@color/card_border" />
                
                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginHorizontal="@dimen/settings_row_padding"
                    android:background="@color/card_border" />

                <!-- Privacy Policy -->
                <LinearLayout
                    android:id="@+id/linkPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/primary_light"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privacy Policy"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="consoleflow.karrarnazim.space/privacy"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginHorizontal="@dimen/settings_row_padding"
                    android:background="@color/card_border" />

                <!-- GitHub -->

                <LinearLayout
                    android:id="@+id/linkGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/settings_row_padding"
                    android:paddingVertical="@dimen/spacing_12"
                    android:background="@drawable/menu_item_ripple">
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_code"
                        android:tint="@color/tertiary_light"
                        android:scaleType="fitCenter" />
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GitHub Repository"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="@dimen/text_size_body_large"
                            android:textStyle="bold" />
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open source project"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:layout_marginTop="@dimen/spacing_4" />
                    </LinearLayout>
                    
                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/arrow_right"
                        android:tint="@color/dark_text_tertiary"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
            
            <!-- Bottom Padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_32" />
        </LinearLayout>
    </ScrollView>
    
</LinearLayout>
